# اجازهٔ عبور هدر Authorization به PHP
RewriteEngine On

# ---------- محافظت امنیتی ----------
<FilesMatch "^(install|setup-libs)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|sql|log|bak|old|ini|yml|yaml|md)$">
  Require all denied
</FilesMatch>
Options -Indexes
ServerSignature Off
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# اجبار HTTPS (رفع هشدار "insecure connection" و جلوگیری از افشای توکن روی HTTP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# فایل‌های واقعی مستقیم سرو شوند (panel.html, vendor/*, setup-libs.php, ...)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# بقیه به فرانت‌کنترلر
RewriteRule ^ index.php [QSA,L]

DirectoryIndex index.php

# ---------- بهبود سرعت بارگذاری ----------
# فشرده‌سازی gzip برای کاهش حجم انتقال (کتابخانه‌ها و صفحات)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml \
    application/javascript application/x-javascript application/json image/svg+xml \
    application/font-woff application/font-woff2 font/woff font/woff2
</IfModule>

# کش طولانی برای فایل‌های ثابت (نسخه‌دار) و عدم‌کش برای HTML تا نسخهٔ جدید دیده شود
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
